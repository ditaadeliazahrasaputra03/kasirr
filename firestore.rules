rules_version = '2';

// Aturan keamanan Firestore untuk TUGAS/KELAS: semua data hanya bisa
// dibaca/ditulis pengguna yang sudah login. Untuk produksi, persempit
// lagi (mis. hanya admin yang boleh tulis koleksi menus).
service cloud.firestore {
  match /databases/{database}/documents {
    match /menus/{menuId} {
      allow read, write: if request.auth != null;
    }
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId} {
      // Pengguna boleh membaca dokumen role siapa pun (dibutuhkan saat
      // login) dan menulis dokumennya sendiri (saat daftar).
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
